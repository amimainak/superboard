// ============================================================
// Superboard — Prisma Schema
// ============================================================
// PostgreSQL via Supabase. DATABASE_URL loaded from .env.
//
// SECURITY FIXES:
// - V-15: Added enum constraints for tier, subject, and invite status
// - V-17: Added length constraints on snapshot fields
// - V-18: Added AGENCY_STANDARD/AGENCY_PREMIUM tiers, Student model,
//         Room duration tracking, lesson hour metered billing
// ============================================================

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ============================================================
// User — Tutors & Agency Owners
// ============================================================
// parentAgencyId links a sub-tutor to their agency owner.
// An agency owner has tier=AGENCY_STANDARD or AGENCY_PREMIUM and no parentAgencyId.
// ============================================================

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  name              String?
  stripeCustomerId  String?         @unique
  stripeSubscriptionId String?      // Active Stripe subscription ID
  // SECURITY FIX (V-15): Enum constraint for tier — prevents invalid tier values
  tier              Tier            @default(FREE)
  isAdmin           Boolean         @default(false)
  status            UserStatus      @default(ACTIVE)
  fingerprintHash   String?
  gracePeriodEndsAt DateTime?
  // Referral System
  referralCode       String?         @unique // This user's unique referral code
  referredByCode     String?         // Who referred this user
  referralCount       Int             @default(0) // How many users this user has referred
  referralRewardClaimed Boolean      @default(false) // Whether the referral reward was claimed
  // AI Budget Tracking
  monthlyAiBudgetCents Int           @default(0) // Monthly AI spend tracking (cents)
  // Agency Features
  customDomain      String?         @unique
  brandingLogoUrl   String?
  brandingColor     String?         // Hex code e.g., #FF5733
  agencyName        String?         // Display name for the agency (for branded experiences)
  parentAgencyId    String?         // If this user is a sub-tutor under an agency
  agencyOwner      User?           @relation("AgencySubTutors", fields: [parentAgencyId], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  // Relations
  rooms             Room[]
  usageLogs         UsageLog[]
  templates         Template[]
  subscriptions     Subscription[]
  sentInvites       AgencyInvite[]  @relation("InviteSender")
  receivedInvite    AgencyInvite?   @relation("InviteRecipient")
  subTutors        User[]          @relation("AgencySubTutors")
  auditLogs         AuditLog[]
  students          Student[]       // Students registered by this agency owner
  scheduledLessons  ScheduledLesson[]
  webhooks          WebhookConfig[]
  lessonNotes       LessonNote[]
  homeworksAgency   Homework[]       @relation("AgencyHomeworks")
  homeworksTutor    Homework[]       @relation("TutorHomeworks")
  resourceLibrary   ResourceLibrary[] @relation("AgencyResources")
  invoices          Invoice[]        @relation("AgencyInvoices")
  creditPacks       CreditPack[]
}

// Lesson scheduling status
enum LessonStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

// SECURITY FIX (V-15, V-18): Enum for user tier levels
enum Tier {
  FREE
  PRO
  AGENCY
  AGENCY_STANDARD
  AGENCY_PREMIUM
}

// User account status
enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

// ============================================================
// Student — Agency Student Roster
// ============================================================
// Agencies register their students with email + name.
// Students must be active to join lessons.
// Unique per agency+email — same email can exist at different agencies.
// ============================================================

model Student {
  id              String    @id @default(uuid())
  agencyId        String
  agency          User      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  email           String
  name            String
  grade           String?   // e.g., "Grade 5", "Year 10"
  phone           String?   // Student or parent contact phone
  parentName      String?   // Parent/guardian name
  parentEmail     String?   // Parent/guardian email for notifications
  parentAccessToken String? @unique // Token for parent portal access (no login required)
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  deactivatedAt   DateTime? // Set when student leaves the agency
  notes           String?   @db.Text // General notes about the student (learning style, goals, etc.)

  @@unique([agencyId, email])
  @@index([agencyId, isActive])
  @@index([email])
  @@index([parentAccessToken])

  // Relations
  roomParticipants  RoomParticipant[]
  homeworks         Homework[]
  lessonNotes      LessonNote[]
  invoices         Invoice[]
}

// ============================================================
// UsageLog — Per-Period Usage Tracking
// ============================================================
// FREE:  period resets Monday 00:00 UTC (weekly)
// PRO:   period resets on billing cycle date (monthly)
// AGENCY_STANDARD/PREMIUM: period resets on billing cycle date (monthly)
// ============================================================

model UsageLog {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  periodStartDate  DateTime // Monday for Free tier, Billing Day for Pro/Agency
  videoMinutesUsed Int      @default(0)
  aiCreditsUsed    Int      @default(0)
  aiCostCents      Int      @default(0) // Actual AI spend in cents this period
  recordingsUsed   Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([userId, periodStartDate])
  @@index([userId])
}

// ============================================================
// Room — Lesson Rooms
// ============================================================
// Each room belongs to a tutor (who may be a sub-tutor under an agency).
// Students join rooms and are tracked via RoomParticipant.
// Duration tracking for metered hourly billing.
// ============================================================

model Room {
  id              String              @id @default(uuid())
  tutorId         String
  tutor           User                @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  // SECURITY FIX (V-15): Enum constraint for subject
  subject         Subject             @default(GENERAL)
  isActive        Boolean             @default(true)
  startedAt       DateTime?            // When the session was started (first participant joins)
  endedAt         DateTime?            // When the tutor closes the session
  durationMinutes Int                 @default(0) // Calculated on room close
  // Branding snapshot taken at room creation so it persists
  // even if agency changes logo later
  brandingLogo    String?
  brandingColor   String?
  lessonNotes     LessonNote[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  // Relations
  pages           BoardPage[]
  recordings      Recording[]
  participants    RoomParticipant[]

  @@index([tutorId, isActive])
  @@index([endedAt])
}

// SECURITY FIX (V-15): Enum for room subjects
enum Subject {
  MATH
  SCIENCE
  LANGUAGE
  GENERAL
  MUSIC
  CODING
  TEST_PREP
  ART
  ESL
}

model BoardPage {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  pageIndex Int
  // SECURITY FIX (V-17): Added length constraint on snapshot (max 5MB of JSON text)
  snapshot  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, pageIndex])
  @@index([roomId, pageIndex])
}

// ============================================================
// RoomParticipant — Student Join Tracking
// ============================================================
// Tracks every time a student joins a room.
// Used for agency billing and attendance tracking.
//
// studentId links to the Student model (registered agency students).
// studentIdentity is the display identifier (Student.name or fallback).
// ============================================================

model RoomParticipant {
  id               String   @id @default(uuid())
  roomId           String
  room             Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  studentId        String?  // FK to Student model (nullable for backward compat)
  student          Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  studentIdentity  String   // Display name or identifier
  studentName      String?  // Display name provided during join
  joinedAt         DateTime @default(now())
  lastActiveAt     DateTime @default(now())

  // A student can join a room multiple times, but we track
  // the latest visit via lastActiveAt (upserted on rejoin).
  @@unique([roomId, studentIdentity]) // One record per student per room
  @@index([roomId, lastActiveAt])
  @@index([studentIdentity, lastActiveAt])
  @@index([studentId])
}

// ============================================================
// Template — Saved Board Layouts
// ============================================================

model Template {
  id        String   @id @default(uuid())
  tutorId   String
  tutor     User     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  name      String
  // SECURITY FIX (V-15): Enum constraint for subject
  subject   Subject
  // SECURITY FIX (V-17): Added length constraint on snapshot (max 5MB of JSON text)
  snapshot  String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tutorId, updatedAt])
}

// ============================================================
// Recording — Lesson Recordings
// ============================================================

model Recording {
  id        String   @id @default(uuid())
  roomId    String
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tutorId   String
  url       String   // Storage URL for the video file (Supabase Storage)
  status    String   @default("STOPPED") // STARTED, STOPPED, FAILED
  duration  Int      @default(0)  // Recording duration in seconds
  egressId  String?  // LiveKit Egress ID
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([tutorId, createdAt])
}

// ============================================================
// AgencyInvite — Sub-Tutor Invitation
// ============================================================
// An agency owner sends an invite to a tutor's email.
// The tutor clicks the invite link to accept and become a sub-tutor.
//
// Status flow: PENDING → ACCEPTED | EXPIRED | CANCELLED
// An invite expires after 7 days automatically.
// ============================================================

model AgencyInvite {
  id             String   @id @default(uuid())
  code           String   @unique // 8-char alphanumeric code for URL: /invite/{code}
  agencyId       String
  agency         User     @relation("InviteSender", fields: [agencyId], references: [id], onDelete: Cascade)
  invitedEmail   String   // The email of the person being invited
  recipientId    String?  @unique // Set when the invite is accepted (links to User)
  recipient      User?    @relation("InviteRecipient", fields: [recipientId], references: [id], onDelete: SetNull)
  // SECURITY FIX (V-15): Enum constraint for invite status
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime // Invite expires at this time
  acceptedAt     DateTime? // Set when accepted
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([invitedEmail, status])
}

// SECURITY FIX (V-15): Enum for invite status
enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELLED
}

// ============================================================
// Subscription — Stripe Subscription Tracking
// ============================================================
// Synced from Stripe webhooks. Stores current state so admin
// can view billing status without querying Stripe API each time.
// ============================================================

model Subscription {
  id                    String          @id @default(uuid())
  userId                String
  user                  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeSubscriptionId  String          @unique
  planName              String          // e.g., "Pro Tutor", "Agency Standard", "Agency Premium"
  status                String          // active, past_due, canceled, trialing, unpaid
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  cancelAtPeriodEnd     Boolean         @default(false)
  amountMonthlyCents    Int             // Price in cents (e.g., 1000 = $10.00)
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  @@index([userId])
  @@index([status])
  @@index([currentPeriodEnd])
}

// ============================================================
// AuditLog — Admin Action Trail
// ============================================================
// Every admin write action is logged here for accountability.
// ============================================================

model AuditLog {
  id           String   @id @default(uuid())
  adminId      String
  admin        User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  action       String   // e.g., "USER_TIER_CHANGE", "USER_BAN", "ROOM_CLOSE"
  targetType   String?  // e.g., "User", "Room"
  targetId     String?  // ID of the affected resource
  metadata     String?  @db.Text // JSON string with details of the change
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([createdAt])
}

// ============================================================
// ScheduledLesson — Tutor Lesson Scheduling
// ============================================================
// Tutors can schedule future lessons. Each lesson has a time,
// duration, subject, and optional student invite.
// ============================================================

model ScheduledLesson {
  id            String    @id @default(uuid())
  tutorId       String
  tutor         User      @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  title         String
  description   String?   @db.Text
  subject       Subject   @default(GENERAL)
  studentEmail  String?   // Email of invited student
  studentName   String?   // Name of invited student
  scheduledAt   DateTime  // When the lesson is scheduled
  durationMinutes Int     @default(60)
  timeZone      String    @default("UTC")
  status        LessonStatus @default(SCHEDULED)
  roomUrl       String?   // Generated room URL when created
  reminderSent  Boolean   @default(false)
  maxStudents   Int       @default(1)  // Max students for group lessons (1 = individual)
  isGroup       Boolean   @default(false) // Whether this is a group lesson
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tutorId, scheduledAt])
  @@index([tutorId, status])
}

// ============================================================
// WebhookConfig — User Webhook Endpoints
// ============================================================
// Users register webhook URLs to receive event notifications.
// Each webhook has a unique HMAC secret for payload verification.
// ============================================================

model WebhookConfig {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  url       String
  events    String[] // Array of event types this webhook listens to
  secret    String   // HMAC secret for signature verification
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([userId])
}

model PlatformConfig {
  id                String   @id @default("platform") // Singleton row
  maintenanceMode   Boolean  @default(false)
  announcementText String? @db.Text
  updatedAt         DateTime @updatedAt
}

// ============================================================
// CreditPack — Prepaid Hourly Credit Packs for Agencies
// ============================================================
// Agencies can buy prepaid hourly packs to smooth cash flow.
// Each pack has a fixed number of hours at a discounted rate.
// Hours are decremented as lessons run (via metered billing).
// ============================================================

model CreditPack {
  id              String    @id @default(uuid())
  agencyId        String
  agency          User      @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  hoursPurchased  Float     // Number of hours in this pack (e.g., 20)
  hoursRemaining  Float     @default(0) // Remaining unused hours
  pricePaidCents  Int       // What the agency paid (e.g., 5000 = $50)
  stripePaymentIntentId String? @unique // Stripe Payment Intent ID
  status          CreditPackStatus @default(ACTIVE)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([agencyId, status])
}

enum CreditPackStatus {
  ACTIVE
  EXHAUSTED
  EXPIRED
}

// ============================================================
// Homework — Assignments for Students
// ============================================================
// Tutors can assign homework after a lesson. Students (or their parents)
// can view pending homework. Tutors can mark as complete and add feedback.
// ============================================================

enum HomeworkStatus {
  PENDING
  SUBMITTED
  GRADED
  OVERDUE
}

model Homework {
  id              String         @id @default(uuid())
  agencyId        String
  agency          User           @relation("AgencyHomeworks", fields: [agencyId], references: [id], onDelete: Cascade)
  studentId       String?
  student         Student?        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  tutorId         String
  tutor           User           @relation("TutorHomeworks", fields: [tutorId], references: [id], onDelete: Cascade)
  roomId          String?         // Which lesson this homework relates to
  title           String
  description     String?        @db.Text
  subject         Subject        @default(GENERAL)
  dueDate         DateTime?
  status          HomeworkStatus  @default(PENDING)
  snapshot        String?        @db.Text // Board snapshot as homework reference
  tutorFeedback   String?        @db.Text // Feedback after grading
  grade           String?        // Grade/score (e.g., "A", "85%", "9/10")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([agencyId, status])
  @@index([studentId, status])
  @@index([tutorId, status])
  @@index([dueDate])
}

// ============================================================
// LessonNote — Post-Lesson Notes & Feedback
// ============================================================
// After a lesson, tutors write notes about what was covered,
// student performance, and topics for next time.
// ============================================================

model LessonNote {
  id              String   @id @default(uuid())
  roomId          String
  room            Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  tutorId         String
  tutor           User     @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  studentId       String?
  student         Student? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  content         String   @db.Text // What was covered in the lesson
  tutorFeedback   String?  @db.Text // Feedback on student performance
  topicsForNext   String?  @db.Text // Topics to cover next session
  rating          Int?     // Student performance rating (1-5)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([roomId]) // One set of notes per room/lesson
  @@index([tutorId, createdAt])
  @@index([studentId, createdAt])
}

// ============================================================
// ResourceLibrary — Shared Agency Resources
// ============================================================
// Agencies can upload and share resources (PDFs, worksheets,
// reference materials) across all their sub-tutors.
// ============================================================

model ResourceLibrary {
  id              String   @id @default(uuid())
  agencyId        String
  agency          User     @relation("AgencyResources", fields: [agencyId], references: [id], onDelete: Cascade)
  uploadedByTutorId String  // Which tutor uploaded it
  name            String
  description     String?  @db.Text
  category        String   @default("general") // general, worksheet, reference, exam, template
  subject         Subject  @default(GENERAL)
  fileUrl         String   // URL to the stored file
  fileType        String   // MIME type (e.g., "application/pdf")
  fileSize        Int      @default(0) // File size in bytes
  downloadCount   Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([agencyId, category])
  @@index([agencyId, subject])
  @@index([uploadedByTutorId])
}

// ============================================================
// Invoice — Agency Billing Invoices
// ============================================================
// Agencies generate invoices for individual students or families.
// Tracks payment status and links to lessons/hours.
// ============================================================

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

model Invoice {
  id              String        @id @default(uuid())
  agencyId        String
  agency          User          @relation("AgencyInvoices", fields: [agencyId], references: [id], onDelete: Cascade)
  studentId       String?
  student         Student?       @relation(fields: [studentId], references: [id], onDelete: SetNull)
  invoiceNumber   String        @unique // e.g., "INV-2024-001"
  description     String?       @db.Text // Invoice description
  amountCents     Int           // Total amount in cents
  currency        String        @default("USD")
  status          InvoiceStatus @default(DRAFT)
  lessonHours     Float         @default(0) // Number of lesson hours billed
  ratePerHourCents Int          @default(0) // Rate per hour in cents
  billingPeriodStart DateTime?  // Start of billing period
  billingPeriodEnd   DateTime?  // End of billing period
  paidAt          DateTime?
  paidAmountCents Int           @default(0)
  dueDate         DateTime?
  notes           String?       @db.Text // Additional notes on the invoice
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([agencyId, status])
  @@index([studentId, status])
  @@index([dueDate])
}

// ============================================================
// QuestionBank — Cloud Question Bank (Sprint 1)
// ============================================================
// Pre-built, standards-tagged questions organized by subject,
// grade band, curriculum framework, and difficulty.
// Each question includes LaTeX stem, optional SVG diagram paths,
// solution tree, and taxonomy tags.
// ============================================================

// Question type enum for structured question classification
enum QuestionType {
  OPEN
  MCQ
  TRUE_FALSE
  MULTI_SELECT
  FILL_IN_BLANK
  SHORT_ANSWER
  ESSAY
  MATCHING
  ORDERING
}

model QuestionItem {
  id              String   @id @default(uuid())
  // Organization
  subject         String   // MATH, SCIENCE, LANGUAGE, etc.
  gradeBand       String   // K-2, 3-5, 6-8, 9-12
  topic           String   // e.g., "Quadratic Equations", "Forces & Motion"
  difficulty      Int      // 1-5 scale (1=easiest, 5=hardest)
  // Curriculum alignment
  curriculum      String?  // CCSS, NGSS, IB, AQA, etc.
  standardCode    String?  // e.g., "CCSS.MATH.CONTENT.HSA.REI.B.4"
  // Content
  stem            String   @db.Text  // Question text (may contain LaTeX)
  stemLatex       String?  @db.Text  // Raw LaTeX for rendering
  diagramSvg      String?  @db.Text  // SVG path data for diagrams
  answerKey       String   @db.Text  // Correct answer(s)
  solutionSteps   String?  @db.Text  // Step-by-step solution (JSON array)
  distractors     String?  @db.Text  // Wrong answer options (JSON array for MCQs)
  questionType    QuestionType @default(OPEN) // Enum-based question types
  // Test Prep & Curriculum Standard relations
  testPrepCategoryId    String?
  testPrepCategory      TestPrepCategory? @relation("TestPrepQuestions", fields: [testPrepCategoryId], references: [id])
  curriculumStandardId   String?
  curriculumStandard     CurriculumStandard? @relation("CurriculumStandardQuestions", fields: [curriculumStandardId], references: [id])
  // Metadata
  tags            String?  @db.Text  // Comma-separated tags for search
  estimatedTimeSec Int?    // Estimated time to solve (seconds)
  creatorId       String?  // User who created (null for system questions)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([subject, gradeBand])
  @@index([curriculum, standardCode])
  @@index([topic])
  @@index([difficulty])
  @@index([creatorId])
  @@index([testPrepCategoryId])
  @@index([curriculumStandardId])
}

// ============================================================
// TestPrepCategory — Standardized Test Categories (Sprint 2)
// ============================================================
// Groups questions by standardized test (SAT, ACT, AP, STAAR, etc.)
// with subject and grade level for filtering.
// ============================================================

model TestPrepCategory {
  id          String   @id @default(uuid())
  name        String   @unique  // "SAT Math", "ACT English", "STAAR Grade 5 Math", etc.
  testType    String   // SAT, ACT, AP, STAAR, NYSESLAT, etc.
  subject     String   // MATH, ENGLISH, SCIENCE, etc.
  gradeLevel  String?  // Relevant grade level
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   QuestionItem[] @relation("TestPrepQuestions")

  @@index([testType])
  @@index([subject])
}

// ============================================================
// CurriculumStandard — Standards Framework Reference (Sprint 2)
// ============================================================
// Hierarchical curriculum standards (CCSS, NGSS, IB, AQA, etc.)
// that questions can be aligned to. Supports parent-child
// relationships for standard hierarchies.
// ============================================================

model CurriculumStandard {
  id          String   @id @default(uuid())
  code        String   @unique  // "CCSS.MATH.CONTENT.HSA.REI.B.4"
  framework   String   // CCSS, NGSS, IB, AQA, etc.
  subject     String
  gradeBand   String
  topic       String
  description String?  @db.Text
  parentCode  String?  // For hierarchical standards (references parent code, not ID)

  questions   QuestionItem[] @relation("CurriculumStandardQuestions")

  @@index([framework, subject])
  @@index([gradeBand])
}
