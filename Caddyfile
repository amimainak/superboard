# ============================================================
# Superboard — Caddy Reverse Proxy Configuration
# ============================================================
# SECURITY FIX (V-01): Removed SSRF-vulnerable XTransformPort handler.
# HARDENING: Added HSTS, CSP, WebSocket proxy for Hocuspocus.
# ============================================================

# ---- Production HTTPS (auto-provisioned by Caddy) ----
{$DOMAIN:superboard.app} {
        # SECURITY (V-11): TLS configuration
        tls {
                protocols tls1.2 tls1.3
                ciphers TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384 TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        }

        # Limit request body size (prevent oversized payloads)
        request_body {
                max_size 50MB
        }

        # Security headers
        header {
                # HARDENING: HSTS — enforce HTTPS for 2 years, include subdomains
                Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
                X-Content-Type-Options "nosniff"
                X-Frame-Options "DENY"
                Referrer-Policy "strict-origin-when-cross-origin"
                X-Permitted-Cross-Domain-Policies "none"
                Cross-Origin-Opener-Policy "same-origin"
                Cross-Origin-Resource-Policy "same-origin"
                Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"
                -Server
        }

        # WebSocket proxy for Hocuspocus CRDT collaboration server
        handle /hocuspocus/* {
                reverse_proxy localhost:3001 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }

        # Health check endpoint (no auth required)
        handle /api/health {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }

        # Reverse proxy to Next.js (all other routes)
        handle {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }
}

# ---- Development HTTP (localhost only) ----
:81 {
        # Restrict to localhost only
        @notlocal not remote_ip 127.0.0.1 ::1
        respond @notlocal "Forbidden" 403

        # Dev: WebSocket proxy for Hocuspocus
        handle /hocuspocus/* {
                reverse_proxy localhost:3001 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up Upgrade {>Upgrade}
                        header_up Connection {>Connection}
                }
        }

        # Dev: Reverse proxy to Next.js
        handle {
                reverse_proxy localhost:3000 {
                        header_up Host {host}
                        header_up X-Forwarded-For {remote_host}
                        header_up X-Forwarded-Proto {scheme}
                        header_up X-Real-IP {remote_host}
                }
        }
}
